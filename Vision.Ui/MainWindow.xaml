<Window x:Class="Vision.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="IPP-WPF-Vision"
        Width="1500" MinWidth="1500" Height="1000" MinHeight="1000">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="50" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style x:Key="ToolGroupStyle" TargetType="{x:Type GroupBox}" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>

        <Style x:Key="ImageFrameStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="LightGray" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style x:Key="HistogramItemsStyle" TargetType="{x:Type ItemsControl}">
            <!-- UniformGrid의 마지막 bin이 다음 행으로 넘어가지 않도록 1 여유 필요 -->
            <Setter Property="Width" Value="257" />
            <Setter Property="Height" Value="1" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="256" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ContentPresenter}">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Bottom" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistogramFrameStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="HistogramLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="4,2,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="RoiRectangleStyle" TargetType="{x:Type Rectangle}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Stroke" Value="Lime" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeDashArray" Value="4,2" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="TemplateMatchRectangleStyle" TargetType="{x:Type Rectangle}">
            <Setter Property="Stroke" Value="Red" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 상단 도구 모음 -->
        <WrapPanel Grid.Row="0" Margin="6,4,6,0" IsEnabled="{Binding IsIdle}">

            <GroupBox Header="파일" Style="{StaticResource ToolGroupStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="열기" Click="OpenImageButtonClick" />
                    <Button Content="저장" IsEnabled="{Binding HasResultImage}" />
                    <Button Content="초기화" IsEnabled="{Binding HasSourceImage}" Click="ResetImageButtonClick" ToolTip="결과 이미지를 원본으로 되돌립니다." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="히스토그램" Style="{StaticResource ToolGroupStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="평활화" IsEnabled="{Binding CanRun}" Click="EqualizationButtonClick" />
                    <Button Content="이진화" IsEnabled="{Binding CanRun}" Click="BinarizationButtonClick" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="템플릿 매칭" Style="{StaticResource ToolGroupStyle}">
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanRun}" ToolTipService.ShowOnDisabled="True" ToolTip="ROI 영역을 템플릿으로 사용합니다. (ROI 폭 16픽셀 이상)">
                    <Button Content="DIFF" IsEnabled="{Binding IsRoiSelected}" Click="DiffButtonClick" />
                    <Button Content="CORR" IsEnabled="{Binding IsRoiSelected}" Click="CorrButtonClick" />
                    <Button Content="COEFF" IsEnabled="{Binding IsRoiSelected}" Click="CoeffButtonClick" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="공간 필터링" Style="{StaticResource ToolGroupStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="가우시안" IsEnabled="{Binding CanRun}" Click="GaussianButtonClick" />
                    <Button Content="라플라시안" IsEnabled="{Binding CanRun}" Click="LaplacianButtonClick" />
                    <Button Content="소벨" IsEnabled="{Binding CanRun}" Click="SobelButtonClick" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="모폴로지" Style="{StaticResource ToolGroupStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="팽창" IsEnabled="{Binding CanRun}" Click="DilationButtonClick" />
                    <Button Content="수축" IsEnabled="{Binding CanRun}" Click="ErosionButtonClick" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="대상 채널" Style="{StaticResource ToolGroupStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding HasSourceImage}">
                    <CheckBox Margin="4,0" VerticalAlignment="Center" Content="R" IsChecked="{Binding IsRedChannelSelected, Mode=TwoWay}" />
                    <CheckBox Margin="4,0" VerticalAlignment="Center" Content="G" IsChecked="{Binding IsGreenChannelSelected, Mode=TwoWay}" />
                    <CheckBox Margin="4,0" VerticalAlignment="Center" Content="B" IsChecked="{Binding IsBlueChannelSelected, Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="커널 설정" Style="{StaticResource ToolGroupStyle}">
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasSourceImage}">
                    <Label VerticalAlignment="Center" Content="크기" />
                    <ComboBox Width="56" VerticalAlignment="Center" SelectedItem="{Binding KernelSize, Mode=TwoWay}">
                        <sys:Int32>3</sys:Int32>
                        <sys:Int32>5</sys:Int32>
                        <sys:Int32>7</sys:Int32>
                        <sys:Int32>9</sys:Int32>
                        <sys:Int32>11</sys:Int32>
                        <sys:Int32>13</sys:Int32>
                        <sys:Int32>15</sys:Int32>
                        <sys:Int32>17</sys:Int32>
                        <sys:Int32>19</sys:Int32>
                        <sys:Int32>21</sys:Int32>
                        <sys:Int32>23</sys:Int32>
                        <sys:Int32>25</sys:Int32>
                        <sys:Int32>27</sys:Int32>
                        <sys:Int32>29</sys:Int32>
                        <sys:Int32>31</sys:Int32>
                    </ComboBox>
                    <Label Margin="6,0,0,0" VerticalAlignment="Center" Content="시그마" />
                    <Slider Width="100" VerticalAlignment="Center" Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Sigma, Mode=TwoWay}" />
                    <TextBlock Width="30" Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding Sigma, StringFormat=F1}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="보기" Style="{StaticResource ToolGroupStyle}">
                <ComboBox Width="90" VerticalAlignment="Center" IsEnabled="{Binding HasSourceImage}" SelectedValuePath="Tag" SelectedValue="{Binding SelectedImageViewMode, Mode=TwoWay}">
                    <ComboBoxItem Content="컬러" Tag="FullColor" />
                    <ComboBoxItem Content="Red" Tag="Red" />
                    <ComboBoxItem Content="Green" Tag="Green" />
                    <ComboBoxItem Content="Blue" Tag="Blue" />
                </ComboBox>
            </GroupBox>
        </WrapPanel>

        <!-- 본문 -->
        <Grid Grid.Row="1" Margin="6,2,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- 원본 뷰어 -->
            <GroupBox Grid.Column="0" Margin="0,0,3,0" Header="원본 (좌클릭 · 우클릭으로 ROI 지정)">
                <Border Style="{StaticResource ImageFrameStyle}">
                    <Grid x:Name="SourceImageGrid" Background="Transparent" ClipToBounds="True" MouseDown="ImageGridMouseDown" SizeChanged="ImageGridSizeChanged">
                        <Image x:Name="SourceImageView" Stretch="Uniform" IsHitTestVisible="False" Visibility="{Binding HasSourceImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Rectangle x:Name="SourceRoiRectangle" Style="{StaticResource RoiRectangleStyle}" />
                    </Grid>
                </Border>
            </GroupBox>

            <!-- 결과 뷰어 -->
            <GroupBox Grid.Column="1" Margin="3,0" Header="결과">
                <Border Style="{StaticResource ImageFrameStyle}">
                    <Grid x:Name="ResultImageGrid" Background="Transparent" ClipToBounds="True" MouseDown="ImageGridMouseDown" SizeChanged="ImageGridSizeChanged">
                        <Image x:Name="ResultImageView" Stretch="Uniform" IsHitTestVisible="False" />
                        <Rectangle x:Name="ResultRoiRectangle" Style="{StaticResource RoiRectangleStyle}" />
                        <Canvas x:Name="TemplateMatchCanvas" IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </GroupBox>

            <!-- 우측 패널 -->
            <Grid Grid.Column="2" Margin="3,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="내비게이터">
                    <Border Height="300" Style="{StaticResource ImageFrameStyle}">
                        <Image x:Name="NavigatorImageView" Stretch="Uniform" />
                    </Border>
                </GroupBox>

                <GroupBox Grid.Row="1" Margin="0,4,0,0" Header="히스토그램">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource HistogramFrameStyle}">
                            <Grid>
                                <Viewbox Stretch="Fill">
                                    <ItemsControl ItemsSource="{Binding RedHistogram}" Style="{StaticResource HistogramItemsStyle}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Rectangle Height="{Binding}" Fill="Red" RenderOptions.EdgeMode="Aliased" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Viewbox>
                                <TextBlock Style="{StaticResource HistogramLabelStyle}" Text="R" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource HistogramFrameStyle}">
                            <Grid>
                                <Viewbox Stretch="Fill">
                                    <ItemsControl ItemsSource="{Binding GreenHistogram}" Style="{StaticResource HistogramItemsStyle}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Rectangle Height="{Binding}" Fill="Green" RenderOptions.EdgeMode="Aliased" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Viewbox>
                                <TextBlock Style="{StaticResource HistogramLabelStyle}" Text="G" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource HistogramFrameStyle}">
                            <Grid>
                                <Viewbox Stretch="Fill">
                                    <ItemsControl ItemsSource="{Binding BlueHistogram}" Style="{StaticResource HistogramItemsStyle}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Rectangle Height="{Binding}" Fill="Blue" RenderOptions.EdgeMode="Aliased" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Viewbox>
                                <TextBlock Style="{StaticResource HistogramLabelStyle}" Text="B" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="0" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="128" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="255" />
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- 하단 상태 표시줄 -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock FontWeight="Bold" Text="{Binding StatusBadgeText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="150" Height="14" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>

</Window>
